# Only needed for public testnets (local demo needs none of this)
PRIVATE_KEY=
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
# Optional role addresses (default: the deployer)
UNDERWRITER_ADDRESS=
ORACLE_ADDRESS=
VET_ADDRESS=

# Oracle service
DATA_SOURCE=mock          # mock | nasa  (NASA POWER rainfall as a CHIRPS stand-in)
# ORACLE_PRIVATE_KEY=     # required off the local chain

# ---- Phone network (Africa's Talking): USSD service, notifier, phone accounts -------------------------------
# SMS through Africa's Talking. Username "sandbox" = their simulator (free); your app username = live (paid).
# AT_USERNAME=sandbox
# AT_API_KEY=
# AT_SENDER_ID=                 # optional registered sender name (live only)
# SMS_ALLOWLIST=2507XXXXXXXX    # REQUIRED for live SMS on the local chain: only these numbers are texted
#                               # "*" = any number, except the seeded demo numbers 25078800xxxx
# USSD_SHORTCODE=*384*12345#    # what farmers dial, shown in SMS texts
# Secret in the callback URLs you give Africa's Talking (https://<tunnel>/ussd?key=...). Make one: openssl rand -hex 16
# CALLBACK_TOKEN=
# IntouchSMS (Rwandan gateway, direct MTN/Airtel routes). Used before Africa's Talking when set.
# INTOUCH_USERNAME=
# INTOUCH_PASSWORD=
# INTOUCH_SENDER=               # sender name approved on your Intouch account
# INTOUCH_FORMAT=form           # form | json
# INTOUCH_RECIPIENT_FORMAT=intl # intl (250788...) | plus (+250788...) | local (0788...)
# SMS menu channel through an Android phone running "SMS Gateway for Android" (see docs/PHONE_AND_SMS.md, SMS menu channel)
# SMSGATE_URL=https://api.sms-gate.app/3rdparty/v1   # or http://<phone-ip>:8080 in local mode
# SMSGATE_USER=
# SMSGATE_PASSWORD=
# SMSGATE_SIGNING_KEY=          # app: Settings > Webhooks > Signing key
# SMS_PROVIDER=                 # intouch | africastalking | smsgate | log (default: the first one configured, in that order)
# MTN Mobile Money (see docs/MOBILE_MONEY.md). Without these, payments are simulated.
# MOMO_COLLECTION_KEY=          # momodeveloper.mtn.com > Collections > primary key
# MOMO_DISBURSEMENT_KEY=        # momodeveloper.mtn.com > Disbursements > primary key
# MOMO_COLLECTION_USER=         # from: npm run momo -- provision <host>
# MOMO_COLLECTION_API_KEY=
# MOMO_DISBURSEMENT_USER=
# MOMO_DISBURSEMENT_API_KEY=
# MOMO_TARGET_ENV=sandbox       # live Rwanda: mtnrwanda (with MOMO_BASE_URL and MOMO_CURRENCY=RWF from MTN)
# TREASURY_PRIVATE_KEY=         # required off the local chain
# Phone accounts (server-held keys). Required off the local chain: openssl rand -hex 32
# PHONE_KEY_SECRET=
# RECOVERY_DELAY_HOURS=48
