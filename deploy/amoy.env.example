# FarmLedger on Polygon Amoy (testnet, chain 80002). Copy the lines you need into .env at the repository root.
# Step-by-step guide: docs/POLYGON_AMOY.md
#
# 1. Keys: run   node deploy/new-keys.js >> .env   (one key per role + CALLBACK_TOKEN + PHONE_KEY_SECRET)
# 2. Settings below.

# Which deployment the services and the oracle/notifier load (deployments/<NETWORK>.json)
NETWORK=polygonAmoy

# PRIVATE RPC: your free Alchemy API key (dashboard.alchemy.com -> create app -> enable Polygon Amoy).
# Hardhat, the services and the portal server build https://polygon-amoy.g.alchemy.com/v2/<key> from it.
# It is never sent to the browser.
ALCHEMY_API_KEY=<your-api-key>
# Or give full URLs instead (e.g. Infura); these win over the key:
# POLYGON_AMOY_RPC=https://...      (Hardhat deploy/seed)
# RPC_URL=https://...               (services and portal)

# PUBLIC RPC written to web/public/deployment.json for browsers (optional; this is the default)
# PUBLIC_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com

# Farmers' smart accounts (ERC-4337): reuse the canonical EntryPoint v0.7 already on Amoy, deploy our factory and
# paymaster, and fund the paymaster with a little POL so farmers never pay gas.
DEPLOY_AA=true
ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
PAYMASTER_DEPOSIT_ETH=0.1
# Our own bundler (npm run bundler) submits farmers' operations; the portal reaches it at this URL.
BUNDLER_URL=http://localhost:4337

# Public chains reorganise a few blocks now and then: index only events this many blocks deep.
INDEXER_CONFIRMATIONS=3
# Alchemy's free plan scans at most 10 blocks per eth_getLogs (thousands of requests a day on Amoy). Instead a public
# node FINDS the blocks with FarmLedger events, 2000 blocks at a time, and only those blocks' events are read from
# Alchemy (web/server/indexer.js). The public node cannot add events Alchemy does not confirm.
INDEXER_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
INDEXER_CHUNK_BLOCKS=2000

# The seed script tops up every role, demo and service key from the deployer (amounts in scripts/seed-demo.js), so
# only the deployer needs POL from a faucet. SEED_GAS=<amount> would top every key up to that one amount instead.

# Optional: a Safe multisig that becomes the only admin after deployment
# GOVERNANCE_ADDRESS=
